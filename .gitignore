# ===== 基础 GitHub Pages / Jekyll 忽略规则 (来自官方模板) =====
# 参考链接: https://github.com/github/gitignore/blob/main/GitHubPages.gitignore

# Jekyll 构建产物 (每次构建都会重新生成，无需提交)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby 依赖管理 (如果使用 Gemfile)
/vendor
Gemfile.lock
.bundle/

# ===== 常用编辑器与系统文件 =====
# IDE 与编辑器
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 操作系统
.DS_Store
Thumbs.db

# ===== 可能的项目特定文件 (根据需要添加) =====
# 本地环境变量
.env
.env.local

# Node.js 依赖 (如果项目使用了 npm/yarn 管理前端资源)
node_modules/

# Hugo 站点构建产物 (如果使用 Hugo)
/public/
/resources/_gen/
hugo_stats.json
